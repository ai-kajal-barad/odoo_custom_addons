<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view" >
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!--xpath for state-->
            <xpath expr="//header" position="inside">
                <header>
                    <button name="action_state_available" string="Available" type="object" class="oe_highlight"/>
                    <button name="action_state_borrowed" string="Borrowed" type="object" class="oe_highlight" />
                    <button name="action_state_reserved" string="Reserved" type="object" class="oe_highlight" />
                </header>
                <field name="state" widget="statusbar" statusbar_visible="available, borrowed, reserved" />
            </xpath>
            <!--xpath for book(product) tab-->
            <xpath expr="//page[@name='inventory']" position="after">
                <page name="book" string="Books">
                    <group>
                        <group>
                            <field name="is_library_book"/>
                            <field name="author"/>
                            <field name="publisher"/>
                            <field name="edition"/>
                        </group>
                        <group>
                            <field name="published_date"/>
                            <field name="pages"/>
                            <field name="available"/>
                            <field name="isbn"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <!--xpath for cost price and make it readonly based on condition-->
            <xpath expr="//field[@name='standard_price']" position='attributes'>
                <attribute name='readonly'> sale_ok
                </attribute>
            </xpath>
            <!--invisible field barcode in product.template-->
            <xpath expr="//field[@name='barcode']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <!--product menu & submenu-->
    <menuitem id="menu_product" name="Products" parent="menu_library" sequence='8'/>
        <menuitem
            name="Products"
            id="menu_products"
            action="sale.product_template_action"
            parent="menu_product"
            sequence='10'/>
</odoo>
