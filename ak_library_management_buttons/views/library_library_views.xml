<?xml version="1.0"?>
<odoo>
    <data>
        <!--library form view-->
        <record model="ir.ui.view" id="view_library_form">
            <field name="name">Library </field>
            <field name="model">library.library</field>
            <field name="arch" type="xml">
                <form string="Library">
                    <sheet>
                        <!--button box for borrowed book count -->
                        <div name="button_box" >
                            <button name="action_view_borrow_book" string="Borrowed Book"
                                    type="object" class="oe_stat_button" icon="fa-book">
                                 <field name ="borrow_book_count" widget="stateinfo"/>
                            </button>
                        </div>
                        <group>
                            <field name="name" required="True"/>
                            <field name="location"/>
                            <field name="capacity"/>
                            <field name="notes"/>
                            <field name="member_id"/>
                        </group>
                        <notebook>
                            <!--page for product_ids-->
                            <page string="Books" name="product">
                                <field name="product_ids">
                                    <list string="Books" create="false" edit="false"
                                          editable="bottom">
                                        <field name="name"/>
                                        <field name="author"/>
                                        <field name="publisher"/>
                                        <field name="edition"/>
                                        <field name="published_date"/>
                                        <field name="pages"/>
                                        <field name="isbn"/>
                                        <field name="list_price"/>
                                        <field name="standard_price"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!--library list view-->
        <record model="ir.ui.view" id="view_library_tree">
            <field name="name">Library List</field>
            <field name="model">library.library</field>
            <field name="arch" type="xml">
                <list string="Library">
                    <field name="name"/>
                    <field name="location"/>
                    <field name="capacity"/>
                    <field name="notes"/>
                    <field name="member_id"/>
                </list>
            </field>
        </record>
        <!--action-->
        <record model="ir.actions.act_window"
                id="action_library_library">
                <field name="name">Library</field>
                <field name="res_model">library.library</field>
        </record>
        <!--library menu-->
        <menuitem
            name="Library"
            id="menu_library_library"
            action="action_library_library"
            parent="menu_library"
            sequence='4'/>
    </data>
</odoo>
