<odoo>
        <!--custom wizard for validation error-->
        <record id="view_sale_order_check_quantity_wizard" model="ir.ui.view">
            <field name="name">sale.order.wizard.form</field>
            <field name="model">sale.order.wizard</field>
            <field name="arch" type="xml">
                <form string="Validation Wizard">
                    <group>
                        <field name="message" />
                    </group>
                    <footer>
                        <button string="OK" special="cancel" class="oe_highlight"/>
                    </footer>
                </form>
            </field>
        </record>
</odoo>
