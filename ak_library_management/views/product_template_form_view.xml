<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view" >
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!--xpath for state -->
            <xpath expr="//header" position="inside">
                <button name="action_state_available" string="Available" type="object"
                        class="oe_highlight" invisible="state not in('borrowed','returned')"/>
                <button name="action_state_borrowed" string="Borrow" type="object"
                        class="oe_highlight" invisible="state not in('available','returned')"/>
                <button name="action_state_returned" string="Return" type="object"
                        class="oe_highlight" invisible="state not in('available','borrowed')"/>
<!--                <field name="state" widget="statusbar" statusbar_visible="available, borrowed, reserved" />-->
                <field name="state" widget="statusbar" statusbar_visible="available,borrowed,returned,unavailable"
                       options="{'clickable':'1'}"/>
            </xpath>
            <xpath expr="//button[@name='action_open_label_layout']" position='after'>
                <button name="compute_display_name"  string="Continue" type="object"/>
                <button name="action_borrow_books" string="Borrow Books" type="object"/>
            </xpath>
            <!--xpath for book(product) tab-->
            <xpath expr="//page[@name='inventory']" position="after">
                <page name="book" string="Books">
                    <group>
                        <group>
                            <field name="is_bulk_book"/>
                            <field name="author"/>
                            <field name="publisher"/>
                            <field name="edition"/>
                        </group>
                        <group>
                            <field name="published_date"/>
                            <field name="pages"/>
                            <field name="available"/>
                            <field name="isbn"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <!--main menu and sub menu-->
    <menuitem
        name="Books"
        id="menu_products"
        action="sale.product_template_action"
        parent="menu_library"
        sequence='5'/>
</odoo>
