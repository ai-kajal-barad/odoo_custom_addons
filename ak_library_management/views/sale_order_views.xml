<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form" model="ir.ui.view" >
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!--xpath for new fields-->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="approval_needed"/>
                <field name="is_approved" invisible="1"/>
            </xpath>
            <!--apply attribute on action confirm method-->
            <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                  <attribute name="invisible">state != 'draft' or approval_needed != False and not is_approved</attribute>
            </xpath>
            <!-- xpath for new buttons-->
            <xpath expr="//header" position="inside">
                <button name="action_approve" type="object" string="Approve"
                        class="oe_highlight" invisible="approval_needed != True"/>
                <button name="action_reject" type="object" string="Reject"
                        class="oe_highlight" invisible="approval_needed != True "/>
            </xpath>
        </field>
    </record>
    </data>
</odoo>
