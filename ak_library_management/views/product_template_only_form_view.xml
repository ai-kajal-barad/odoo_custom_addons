<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view" >
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!--xpath for state-->
            <xpath expr="//header" position="inside">
                <header>
                    <button name="action_state_available" string="Available" type="object"
                            class="oe_highlight" invisible="state not in('borrowed','reserved')"/>
                    <button name="action_state_borrowed" string="Borrowed" type="object"
                            class="oe_highlight" invisible="state not in('available','reserved')"/>
                    <button name="action_state_reserved" string="Reserved" type="object"
                            class="oe_highlight" invisible="state not in('available','borrowed')"/>
                </header>
                <field name="state" widget="statusbar" statusbar_visible="available, borrowed, reserved" />
            </xpath>
            <!--xpath for book(product) tab-->
            <xpath expr="//page[@name='inventory']" position="after">
                <page name="book" string="Books">
                    <group>
                        <group>
                            <field name="is_library_book" required="True"/>
                            <field name="author" required="True"/>
                            <field name="publisher"/>
                            <field name="edition"/>
                        </group>
                        <group>
                            <field name="published_date"/>
                            <field name="pages"/>
                            <field name="available"/>
                            <field name="isbn"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <!--invisible field barcode in product.template-->
            <xpath expr="//field[@name='barcode']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <!--main menu and product.template menu -->
    <menuitem id="menu_library" name="Library Management" sequence='3'/>
    <menuitem
            name="Books"
            id="menu_products"
            action="sale.product_template_action"
            parent="ak_library_management_buttons.menu_library"
            sequence='5'/>
</odoo>

